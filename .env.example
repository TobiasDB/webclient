# web -- environment configuration.
#
# Every operational knob is a WEB_* variable; an explicit CLI flag or function argument always
# overrides it. Copy to `.env` and edit, or just `export` the ones you need. See
# webclient/onboard/web/onboard/config.py for the authoritative list.

# ── LLM (onboard: the frontier / review / author model) ───────────────────────
# A custom model on your own Anthropic-compatible gateway (self-hosted, a corporate proxy, …):
WEB_LLM_MODEL=claude-sonnet-5
WEB_LLM_API_KEY=sk-your-key-here                     # else falls back to ANTHROPIC_API_KEY
WEB_LLM_BASE_URL=https://llm.internal.example/       # else ANTHROPIC_BASE_URL, else the public API
# WEB_LLM_RATE=1.0                                    # min seconds between calls (a shared key)
#
# …or drive a REAL model with NO API key via the local `claude -p` CLI (Claude Code subscription):
# WEB_LLM_SHIM=1
# WEB_LLM_MODEL=haiku
# WEB_LLM_TIMEOUT=90                                  # per-call timeout for the shim

# ── Browser executable (fetch: every browser tier) ────────────────────────────
# Pin the exact binary any browser tier launches -- a system Chrome, a hardened/enterprise build,
# or a self-managed Chromium -- instead of the bundled one:
WEB_BROWSER_PATH=/usr/bin/google-chrome

# ── Proxy for ALL fetches (resolve/fetch) ─────────────────────────────────────
# Route every request through a proxy (e.g. a residential / mobile egress for the top of the
# anti-bot ladder). Applies to HTTP and browser tiers alike:
WEB_PROXY=http://user:pass@proxy.example:8080

# ── Transport profile (resolve) ───────────────────────────────────────────────
# basic (HTTP only) | basic_browser (default: HTTP, escalate to a browser on a block) | full_browser
# WEB_PROFILE=full_browser
