from __future__ import annotations
from pydantic import BaseModel
from typing import overload, Literal, Self, Iterator
from urllib.parse import urlparse, parse_qs

class Reference(BaseModel):
    @classmethod
    def from_url(cls, url: str, method: str = "get", params: dict[str, str] = None, headers: dict[str, str] = None, cookies: dict[str, str] = None) -> Reference:
        parsed_url = urlparse(url)
        query_params = {k: v[0] for k, v in parse_qs(parsed_url.query).items()}
        if params:
            query_params.update(params)
        return cls(
            hostname=parsed_url.hostname or "",
            method=method,
            scheme=parsed_url.scheme or "https",
            port=parsed_url.port or 443,
            path=parsed_url.path or "",
            fragment=parsed_url.fragment or "",
            params=query_params,
            headers=headers or {},
            cookies=cookies or {},
        )
    
    hostname: str
    method: str = "get"
    scheme: str = "https"
    port: str = 443
    path: str = ""
    fragment: str = ""

    params: dict[str, str] = {}
    headers: dict[str, str] = {}
    cookies: dict[str, str] = {}
    follow_redirects: bool = True

    @overload
    def fetch(self) -> Document: ...
    @overload
    def fetch(self, browser: bool = True, scripts: list[Script] = None) -> LiveDocument: ...

    @overload
    def reload(self) -> Document: ...
    @overload
    def reload(self, browser: bool = True) -> LiveDocument: ...


class Document(Reference):
    kind: Literal["html", "json", "xml", "binary"] = "html"
    content: bytes
    status_code: int

    @property
    def text(self) -> str:
        return self.content.decode("utf-8")

    @property
    def html(self) -> HTMLDocument: ...  # explicit typing for html document

    @property
    def json(self) -> JSONDocument: ...  # explicit typing for json document

    @property
    def xml(self) -> XMLDocument: ...  # explicit typing stub for xml document

    @property
    def binary(self) -> BinaryDocument: ...  # explicit typing for binary document

    @overload
    def attr(self, name: Literal["href"]) -> Reference: ...
    @overload
    def attr(self, name: Literal["text"]) -> str: ...
    @overload
    def attr(self, name: str) -> str: ...

    @overload
    def select(self, selector: str, first: bool = True) -> Document: ...
    @overload
    def select(self, selector: str, first: bool = True, optional: bool = True) -> Document | None: ...
    @overload
    def select(self, selector: str, last: bool = True) -> Document: ...
    @overload
    def select(self, selector: str, last: bool = True, optional: bool = True) -> Document | None: ...
    @overload
    def select(self, selector: str, nth: int) -> Document: ...
    @overload
    def select(self, selector: str, nth: int, optional: bool = True) -> Document | None: ...
    @overload
    def select(self, selector: str) -> Document: ...
    @overload
    def select(self, selector: str, optional: bool = True) -> Document | None: ...

    def select_all(self, selector: str, limit: int | None = None, offset: int = 0) -> list[Document]: ...

    def paginate(self, on, until, limit: int | None = None, resume: Reference | None = None) -> Iterator[Document]: ...
    """
    Paginate by modifying the Reference using either a fixed iterable e.g. date range or int range  or by a selector that returns a value to be used to modify the Reference for the next page, until a condition is met or a limit is reached.
    The selector is evaluated on the current page, otherwise the fixed iterable is used.
    The condition is evaluated on the next page
    The limit is a hard limit on the number of pages to fetch, the offset is a hard limit on the number of pages to skip before starting to fetch.
    Resume is a Reference to the last page fetched, this allows for resuming pagination from a previous state.
    Pagination on a document has concurrency, the next page will be fetched while the current page is being processed, this allows for faster pagination but requires careful management of the state of the document and may require re-fetching the document to reset its state
    """

class LiveDocument(Document):
    # All actions have an implicit wait for selector to load, this behavior can be overridden by passing a wait_for parameter to the action
    # All actions have a implicit timeout, this behavior can be overridden by passing a timeout parameter to the action
    # All actions have an optional parameter implying no implicit wait and not raising an error if the element is not found, this behavior can be overridden by passing an optional parameter to the action
    # Overrides the select and select_all methods to use the implicit wait and timeout behavior
    # Overrides the attr method to use the implicit wait and timeout behavior
    # Overrides the select and select_all methods to return a LiveDocument instead of a Document, Careful live documents are stateful, actions on them will change the state of the document and may affect subsequent actions, this requires careful management of the state of the document and may require re-fetching the document to reset its state
    # actions are recorded in the actions list, this allows for replaying the actions on a new document to reproduce the same state
    # XHR requests are recorded in the xhr_requests list, this allows for replaying the XHR requests on a new document to reproduce the same state
    # DOM manipulations are recorded in the dom_manipulations list, this allows for replaying the DOM manipulations on a new document to reproduce the same state
    # Events are published to a shared event bus for which LiveDocument instances can subscribe to, this allows for reacting to events in a decoupled manner
    # Navigating will create a new LiveDocument instance, this allows for navigating to a new page and continuing to interact with it in a stateful manner, the underlying playwright page will be reused to maintain the session and state of the browser
    xhr_requests: list[NetworkEvent] = []
    dom_manipulations: list[DOMEvent] = []
    actions: list[ActionEvent] = []

    def click(self, selector: str) -> Self: ...
    def write(self, selector: str, text: str) -> Self: ...
    def press(self, key: str) -> Self: ...
    def hover(self, selector: str) -> Self: ...
    def screenshot(self) -> BinaryDocument: ...
    def execute(self, script: str) -> Self: ...

    @overload
    def navigate(self, url: Reference) -> LiveDocument: ...
    @overload
    def navigate(self, url: str, headers: dict[str, str], wait_for: Literal["load", "domcontentloaded", "networkidle"]) -> LiveDocument: ...

    @overload
    def scroll(self, selector: str, x: int = 0, y: int = 0) -> Self: ...
    @overload
    def scroll(self, x: int = 0, y: int = 0) -> Self: ...

    @overload
    def wait_for(self, selector: str, *,timeout: int, visible: bool) -> Self: ...
    @overload
    def wait_for(self, event: Literal["load", "domcontentloaded", "networkidle"], timeout: int) -> Self: ...
    @overload
    def wait_for(self, timeout: int) -> Self: ...

    def paginate(self, *args, **kwargs) -> Iterator[LiveDocument]: ...
        """
        Paginate by modifying the Reference using either a fixed iterable e.g. date range or int range  or by a selector using .select() that returns a value to be used or a action, until a condition is met or a limit is reached.
        The selector is evaluated on the current page, otherwise the fixed iterable is used.
        The condition is evaluated on the next page and can also be a action
        The limit is a hard limit on the number of pages to fetch, the offset is a hard limit on the number of pages to skip before starting to fetch.
        Resume is a Reference to the last page fetched, this allows for resuming pagination from a previous state, action iterators are not resumable.
        Pagination on a live document has no concurrency, it will yield the next page only after the previous page has been fully processed
        """

ref = Reference.from_url("https://example.com/path/to/resource?query=param#fragment")
doc = ref.fetch()  # This will return a Document object   

for card in doc.select_all(".card"):
    title = card.select(".title").attr("text")
    link = card.select(".link").attr("href")
    print(f"Title: {title}, Link: {link}")

    sub_doc = link.fetch(browser=True)  # This will return a Document object for the linked page
    sub_doc.click(".load-more")
    sub_doc.wait_for(".content", timeout=5000, visible=True)
    sub_doc.select(".content").attr("text")


# Lazy auto wraps a class and converts its interface to a lazy interface
REF = Lazy(Reference)
DOC = Lazy(Document)
LIVE_DOC = Lazy(LiveDocument)

STATE: Literal["skip", "raise_error", "ignore"]

# Think Polars pl.expr / pl.columns style, but for web scraping, where you can chain operations on a reference or document to extract data in a declarative manner.
expr = REF.fetch().select_all(".card").map(
    title=DOC.select(".title").attr("text"),
    is_active=DOC.select(".active").attr("text") == "Active",
    link=DOC.select(".link").attr("href").otherwise(STATE.skip),
).filter(col("is_active")).then(
    sub_doc=col("link").fetch(browser=True).click(".load-more").wait_for(".content", timeout=5000, visible=True).select(".content").attr("text"),
    date=col("sub_doc").select(".date").attr("text"),
).otherwise(STATE.raise_error)

expr.collect(...) # This will execute the expression and return the results as a json-like structure, the results can be streamed or collected in memory depending on the size of the data and the available resources It is run provided the initial context e.g. reference, document, or live document, and the results are returned in a structured format that can be easily consumed by other parts of the application or exported to various formats such as JSON, CSV, or database tables.