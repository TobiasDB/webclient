{
  "name": "webclient-web",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "storybook": "npm run storybook -w @webclient/ui",
    "build:storybook": "npm run build-storybook -w @webclient/ui",
    "dev:playground": "npm run dev -w @webclient/playground",
    "build:playground": "npm run build -w @webclient/playground",
    "dev:site": "npm run dev -w @webclient/site",
    "build:site": "npm run build -w @webclient/site",
    "build": "npm run build -w @webclient/ui && npm run build:playground && npm run build:site",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
